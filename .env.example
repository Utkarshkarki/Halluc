# ==============================================================================
# Haluc Hallucination Detection API Configuration
# ==============================================================================

# Server configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Allowed Origins
# Comma-separated list or JSON array of allowed origins for web clients (e.g. Lovable frontend).
# Default: http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Compute Device ("auto", "cuda", "cpu")
DEVICE=auto

# Optional external LLM claim extraction credentials (test/evaluation only)
# By default, the API uses the deterministic, offline RuleBasedExtractorProvider.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
